 H750_DMA_BUFFER uint8_t defaultFrameBuffer[Camera::kDefaultFrameByteLength] = {};
+
+// A stale DMA buffer repeats a constant byte pattern (e.g. 0x20 0x00), so
+// counting distinct byte values is a cheap "did the sensor actually write?"
+// check. Real image data has many distinct values even in a flat scene.
+bool FrameBufferLooksValid(const uint8_t *buffer, uint32_t length)
+{
+    if ((buffer == nullptr) || (length < 256U)) {
+        return false;
+    }
+    bool seen[256] = {};
+    uint32_t distinct = 0U;
+    const uint32_t sample = (length < 8192U) ? length : 8192U;
+    for (uint32_t i = 0U; i < sample; ++i) {
+        const uint8_t value = buffer[i];
+        if (!seen[value]) {
+            seen[value] = true;
+            ++distinct;
+        }
+    }
+    return distinct > 16U;
+}
 
